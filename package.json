{
  "name": "@eetr/ts-rest-utils",
  "version": "0.0.0",
  "description": "A small, dependency-free REST client for TypeScript — typed responses, pluggable auth, retries, and timeouts.",
  "keywords": [
    "api",
    "client",
    "fetch",
    "http",
    "rest",
    "typescript"
  ],
  "homepage": "https://github.com/eetr-ai/ts-rest-utils#readme",
  "bugs": {
    "url": "https://github.com/eetr-ai/ts-rest-utils/issues"
  },
  "license": "MIT",
  "author": "Juan Lopez Cavallotti <juancavallotti@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eetr-ai/ts-rest-utils.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "oauth": [
        "./dist/oauth/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./oauth": {
      "types": "./dist/oauth/index.d.ts",
      "import": "./dist/oauth/index.js",
      "require": "./dist/oauth/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "pack:local": "npm run build && npm pack"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.0.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
